<Window x:Class="SZOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SZ Optimizer v1.3 | STALZONE Edition (by DFKryakin)" Height="640" Width="900"
        Background="#18191C" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" Focusable="True" FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="#111214"/><Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="BorderBrush" Value="#00D4AA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="MaxWidth" Value="350"/></Style>
        <Style x:Key="HelpBadge" TargetType="Border"><Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="#2F3136"/><Setter Property="Cursor" Value="Help"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="⚡ SZ OPTIMIZER" FontSize="18" FontWeight="Bold" Foreground="#00D4AA" Margin="4,6,0,2"/>
                    <TextBlock Text="STALZONE Edition v1.3" FontSize="11" Foreground="#80848E" Margin="4,0,0,4"/>
                    <TextBlock Text="Создатель: DFKryakin" FontSize="11.5" FontWeight="SemiBold" Foreground="#00D4AA" Margin="4,0,0,2"/>
                    <TextBlock Text="Discord: bylmewka" FontSize="11" Foreground="#B5BAC1" Margin="4,0,0,18"/>
                    <Button x:Name="TabWinBtn" Content="🚀 Оптимизация (v1.3)" Height="36" Background="#2B2D31" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabWinBtn_Click"/>
                    <Button x:Name="TabCrossBtn" Content="🎯 Прицел (0% потерь)" Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabCrossBtn_Click"/>
                    <Button x:Name="TabHwBtn" Content="⚙️ Java и Железо" Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabHwBtn_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#2B2D31" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel><TextBlock x:Name="BackupStatusText" Text="🛡️ Статус: Ожидание игры" FontSize="12" Foreground="#00D4AA" FontWeight="SemiBold"/><TextBlock Text="Безопасный профиль" FontSize="10.5" Foreground="#949BA4" Margin="0,2,0,0"/></StackPanel>
                    </Border>
                    <Button x:Name="BtnRollback" Content="↺ Откатить всё" Height="36" Background="#3A2326" Foreground="#FF6B6B" FontWeight="SemiBold" BorderBrush="#FF6B6B" BorderThickness="1" Cursor="Hand" Click="BtnRollback_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="16">
            <Grid x:Name="PanelWindows" Visibility="Visible">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#222428" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="DiagnosticsText" Text="● ДИАГНОСТИКА: Проверка системы..." FontSize="12.5" Foreground="#00D4AA" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock x:Name="DiagText" Text="• ДИАГНОСТИКА: сканирование..." Foreground="#00D4AA" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="🤖 Автоподбор под железо" Padding="8,2" FontSize="11" Background="#2B2D31" Foreground="#00D4AA" BorderBrush="#00D4AA" BorderThickness="1" Cursor="Hand" Click="BtnAutoTune_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><CheckBox x:Name="ChkAutoStart" Content="⚡ Автозапуск с Windows без окна прав Администратора (Тихий режим)" Foreground="#00D4AA" FontWeight="SemiBold" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/><Border Style="{StaticResource HelpBadge}" ToolTip="Создаёт задачу в Планировщике Windows с наивысшими правами: программа тихо запускается в трее при старте ПК без запроса UAC."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#222428" CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind1" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkAffinity" IsChecked="True" Content="1. Изоляция игры от нулевого ядра CPU 0 (Ровный FPS)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Переводит потоки игры на свободные ядра CPU 1..N, убирая их с CPU 0."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind2" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkGameBoost" IsChecked="True" Content="2. Приоритет игры «Выше среднего» + пауза служб поиска/телеметрии"/><Border Style="{StaticResource HelpBadge}" ToolTip="Поднимает приоритет игры до AboveNormal (не душит DWM) и ставит на паузу поиск и телеметрию Windows."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind3" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkSoftBrowsers" IsChecked="True" Content="3. Мягкая разгрузка фоновых вкладок браузеров (2-й монитор работает)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Снижает приоритет фоновых процессов браузеров без окна. YouTube Music и Discord работают без задержек."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind4" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkCleanLogs" IsChecked="True" Content="4. Очистка старых текстовых логов и дампов крашей STALZONE"/><Border Style="{StaticResource HelpBadge}" ToolTip="Удаляет старые логи в папке игры, не трогая кэш шейдеров NVIDIA и настройки."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind5" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkTrayMode" IsChecked="True" Content="5. Фоновый режим: авто-перехват запуска и выхода из игры"/><Border Style="{StaticResource HelpBadge}" ToolTip="Сворачивает оптимизатор и автоматически включает буст + прицел при входе в STALZONE."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind6" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkTimer" IsChecked="False" Content="6. Сжатие системного таймера Windows до 1.0 мс (опционально)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Уменьшает шаг таймера прерываний. На транзитной графике лучше держать выключенным."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind7" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkNetwork" IsChecked="False" Content="7. Оптимизация TCP/IP (Nagle Off — не включать, если уже настроено)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Включает TCPNoDelay=1 в реестре. Если сеть настроена вручную — оставьте выключенным."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse x:Name="Ind8" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkInput" IsChecked="False" Content="8. Честный ввод мыши 1:1 и отключение залипания Shift"/><Border Style="{StaticResource HelpBadge}" ToolTip="Отключает системное ускорение мыши и всплывающее окно залипания клавиш Shift в бою."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse x:Name="Ind9" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkSleepLaunchers" IsChecked="True" Content="9. Усыпление фоновых лаунчеров во время игры (Steam, Epic, Overwolf)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Мягко снижает приоритет и сбрасывает лишнюю память у Steam, Epic Games, Battle.net, EA App, Riot и Overwolf во время игры. Discord и браузеры с музыкой не затрагиваются."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnAutoWatch" Grid.Column="0" Height="44" Margin="0,0,8,0" Content="👁️ АВТО-ОЖИДАНИЕ STALZONE" Background="#00D4AA" Foreground="#111214" FontSize="13.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAutoWatch_Click"/>
                    <Button x:Name="BtnApplyNow" Grid.Column="1" Height="44" Content="▶ ПРИМЕНИТЬ СЕЙЧАС" Background="#313338" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnApplyNow_Click"/>
                </Grid>
            </Grid>
            <Grid x:Name="PanelCrosshair" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#222428" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="1. Выберите форму прицела:" FontSize="12.5" FontWeight="Bold" Foreground="#00D4AA" Margin="0,0,0,6"/>
                                <UniformGrid x:Name="PresetGalleryGrid" Columns="5" Margin="0,0,0,10"/>
                                <TextBlock Text="2. Визуальная палитра цвета (HSV):" FontSize="12.5" FontWeight="Bold" Foreground="#00D4AA" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="130" BorderBrush="#383A40" BorderThickness="1" ClipToBounds="True">
                                        <Canvas x:Name="SvCanvas" Width="138" Height="128" Background="#FF00D4AA" MouseDown="SvCanvas_MouseDown" MouseMove="SvCanvas_MouseMove" Cursor="Cross">
                                            <Rectangle Width="138" Height="128" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                            <Rectangle Width="138" Height="128" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                            <Ellipse x:Name="SvMarker" Width="10" Height="10" Stroke="White" StrokeThickness="1.5" Canvas.Left="133" Canvas.Top="-5" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Border>
                                    <Border Grid.Column="1" Height="130" Margin="6,0" BorderBrush="#383A40" BorderThickness="1" ClipToBounds="True">
                                        <Canvas x:Name="HueCanvas" Background="Transparent" Width="14" Height="128" MouseDown="HueCanvas_MouseDown" MouseMove="HueCanvas_MouseMove" Cursor="SizeNS">
                                            <Rectangle Width="14" Height="128" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF0000" Offset="0.00"/><GradientStop Color="#FFFFFF00" Offset="0.17"/><GradientStop Color="#FF00FF00" Offset="0.33"/><GradientStop Color="#FF00FFFF" Offset="0.50"/><GradientStop Color="#FF0000FF" Offset="0.67"/><GradientStop Color="#FFFF00FF" Offset="0.83"/><GradientStop Color="#FFFF0000" Offset="1.00"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                            <Rectangle x:Name="HueMarker" Width="14" Height="3" Fill="White" Stroke="Black" StrokeThickness="0.5" Canvas.Top="58" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Текущий цвет" FontSize="10" Foreground="#80848E"/>
                                        <Border x:Name="ColorPreviewBox" Height="32" CornerRadius="4" Background="#00D4AA" BorderBrush="#383A40" BorderThickness="1" Margin="0,2,0,6"/>
                                        <TextBlock x:Name="RgbInfoText" Text="R: 0   G: 212   B: 170" FontSize="11" Foreground="#DCDDDE" Margin="0,0,0,6"/>
                                        <TextBox x:Name="HexColorBox" Text="#00D4AA" Height="26" Background="#18191C" Foreground="White" BorderBrush="#383A40" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="HexColorBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ScaleLabel" Text="3. Размер (Масштаб): 100%" FontSize="12.5" Foreground="#B5BAC1" Margin="0,0,0,3"/>
                                <Slider x:Name="ScaleSlider" Minimum="50" Maximum="300" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="ScaleSlider_ValueChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Сдвиг X:" VerticalAlignment="Center" Margin="0,0,4,0"/><Button Content="-" Width="24" Height="22" Background="#313338" Foreground="White" BorderThickness="0" Click="Offset_Click" Tag="X-"/><TextBlock x:Name="OffsetXText" Text="0" Width="26" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="24" Height="22" Background="#313338" Foreground="White" BorderThickness="0" Margin="0,0,12,0" Click="Offset_Click" Tag="X+"/>
                                    <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/><Button Content="-" Width="24" Height="22" Background="#313338" Foreground="White" BorderThickness="0" Click="Offset_Click" Tag="Y-"/><TextBlock x:Name="OffsetYText" Text="0" Width="26" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="24" Height="22" Background="#313338" Foreground="White" BorderThickness="0" Click="Offset_Click" Tag="Y+"/>
                                </StackPanel>
                                <DockPanel><Button Content="Код в буфер" Height="26" Padding="10,0" Background="#313338" Foreground="#00D4AA" BorderThickness="0" Margin="0,0,6,0" Click="BtnExportCode_Click"/><Button Content="Вставить код" Height="26" Padding="10,0" Background="#313338" Foreground="White" BorderThickness="0" Click="BtnImportCode_Click"/></DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Column="1" Background="#18191C" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ПИКСЕЛЬНЫЙ РЕДАКТОР (16×16)" FontSize="12" FontWeight="Bold" Foreground="#00D4AA" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="ЛКМ — рисовать, ПКМ — стереть" FontSize="11" Foreground="#80848E" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="PixelEditorGrid" Rows="16" Columns="16" Width="240" Height="240" Background="#383A40"/>
                                <Button Content="Очистить сетку" Height="26" Margin="0,8,0,0" Background="#313338" Foreground="White" BorderThickness="0" Click="BtnClearGrid_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><CheckBox x:Name="ChkAutoCrosshair" IsChecked="True" Content="🎯 Автоматически включать прицел при запуске STALZONE" FontWeight="SemiBold" Foreground="#00D4AA"/><Border Style="{StaticResource HelpBadge}" ToolTip="При обнаружении процесса игры оверлей прицела включится сам и скроется после выхода из STALZONE."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="ChkHideOnRmb" IsChecked="True" Content="🎯 Скрывать прицел при зажатии ПКМ (в прицеле)" FontWeight="SemiBold" Foreground="#00D4AA"/><Border Style="{StaticResource HelpBadge}" ToolTip="Мгновенно прячет кастомный прицел при зажатии правой кнопки мыши, чтобы он не мешал штатной мушке или оптическому прицелу."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                        <Button x:Name="BtnToggleOverlay" Grid.Column="0" Height="42" Margin="0,0,8,0" Content="🎯 ВКЛЮЧИТЬ ПРИЦЕЛ (Insert)" Background="#2B2D31" Foreground="#00D4AA" BorderBrush="#00D4AA" BorderThickness="1" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnToggleOverlay_Click"/>
                        <Button x:Name="BtnBindHotkey" Grid.Column="1" Height="42" Content="Клавиша: Insert" Background="#18191C" Foreground="#FFD700" BorderBrush="#383A40" BorderThickness="1" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" Click="BtnBindHotkey_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
                <ScrollViewer x:Name="PanelHardware" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="АППАРАТНАЯ ДИАГНОСТИКА И ОПТИМИЗАЦИЯ (v1.3)" FontSize="15" FontWeight="Bold" Foreground="#00D4AA" Margin="0,0,0,10"/>
                <Border Background="#18191C" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#313338" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="HwCpuText" Text="CPU: сканирование..." Foreground="White" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HwRamText" Text="ОЗУ: сканирование..." Foreground="White" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HwGpuText" Text="GPU: сканирование..." Foreground="#00D4AA" FontSize="12.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="АППАРАТНЫЕ УСКОРИТЕЛИ WINDOWS:" FontSize="12.5" FontWeight="SemiBold" Foreground="#B5BAC1" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><CheckBox x:Name="ChkPcieAspm" IsChecked="True" Content="Отключить энергосбережение шины PCIe (ASPM Off)" Foreground="White"/><Border Style="{StaticResource HelpBadge}" ToolTip="Запрещает Windows переводить линию связи с видеокартой в режим энергосбережения, убирая микрофризы при резких поворотах камеры."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><CheckBox x:Name="ChkGpuPref" IsChecked="True" Content="Принудительно запускать игру на дискретной видеокарте" Foreground="White"/><Border Style="{StaticResource HelpBadge}" ToolTip="Прописывает процесс игры (javaw / stalzonew) в реестр Windows с приоритетом «Высокая производительность» (дискретная видеокарта)."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><CheckBox x:Name="ChkCorePark" IsChecked="True" Content="Отключить парковку ядер CPU (100% активных потоков)" Foreground="White"/><Border Style="{StaticResource HelpBadge}" ToolTip="Удерживает все ядра процессора в активном состоянии (CPMINCORES=100), предотвращая просадки FPS при переходе из спокойных зон в бой."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><CheckBox x:Name="ChkGameMode" IsChecked="True" Content="Включить Игровой режим Windows и планировщик GPU (HAGS)" Foreground="White"/><Border Style="{StaticResource HelpBadge}" ToolTip="Активирует штатный Игровой режим Windows и аппаратное планирование графического процессора для снижения задержки вывода кадров."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                <Button x:Name="BtnApplyHw" Content="⚡ ПРИМЕНИТЬ АППАРАТНЫЕ НАСТРОЙКИ" Height="36" Background="#00D4AA" Foreground="#111214" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14" Click="BtnApplyHw_Click"/>

                <TextBlock Text="ОПТИМИЗАЦИЯ КОНФИГА ГРАФИКИ (OPTIONS.JSON):" FontSize="12.5" FontWeight="SemiBold" Foreground="#B5BAC1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
