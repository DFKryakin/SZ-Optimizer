<Window x:Class="SZOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SZ Optimizer v1.0 | STALZONE Edition" Height="630" Width="880"
        Background="#18191C" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111214"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#00D4AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MaxWidth" Value="350"/>
        </Style>

        <Style x:Key="HelpBadge" TargetType="Border">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#2F3136"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="⚡ SZ OPTIMIZER" FontSize="18" FontWeight="Bold" Foreground="#00D4AA" Margin="4,6,0,2"/>
                    <TextBlock Text="STALZONE Edition v1.0" FontSize="11" Foreground="#80848E" Margin="4,0,0,20"/>

                    <Button Content="🚀 Windows (v1.0)" Height="36" Background="#2B2D31" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6"/>
                    <Button Content="🎯 Прицел (в v1.1)" Height="34" Background="Transparent" Foreground="#6D6F78" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,4" IsEnabled="False"/>
                    <Button Content="⚙️ Железо (в v1.2)" Height="34" Background="Transparent" Foreground="#6D6F78" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,4" IsEnabled="False"/>
                    <Button Content="🔥 Разгон (в v1.3)" Height="34" Background="Transparent" Foreground="#6D6F78" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,4" IsEnabled="False"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#2B2D31" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="BackupStatusText" Text="🛡️ Бэкап: Ожидание" FontSize="12" Foreground="#00D4AA" FontWeight="SemiBold"/>
                            <TextBlock Text="Автооткат при вылете" FontSize="11" Foreground="#949BA4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRollback" Content="↺ Откатить всё" Height="36" Background="#3A2326" Foreground="#FF6B6B" FontWeight="SemiBold" BorderBrush="#FF6B6B" BorderThickness="1" Cursor="Hand" Click="BtnRollback_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#222428" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="DiagnosticsText" Text="● ДИАГНОСТИКА: Проверка системы..." FontSize="12.5" Foreground="#00D4AA" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="BtnBrowseGame" DockPanel.Dock="Right" Content="Обзор..." Width="75" Height="26" Background="#313338" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnBrowseGame_Click"/>
                        <TextBox x:Name="GamePathBox" Height="26" Background="#18191C" Foreground="#DCDDDE" BorderBrush="#313338" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0" Text="Поиск stalzonew.exe..."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#222428" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkRamShader" IsChecked="True" Content="🟢 1. Умная очистка кэша шейдеров и ОЗУ (Standby List)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Очищает старый кэш OpenGL/NVIDIA и сбрасывает закэшированный мусор в ОЗУ.&#x0a;ЗАЧЕМ НУЖНО: Убирает статтеры при долгих сессиях в STALZONE.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkNetwork" IsChecked="True" Content="🟢 2. Оптимизация сети (Откл. задержки Nagle и сна адаптера)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Включает TCPNoDelay=1 и отключает энергосбережение сетевой карты.&#x0a;ЗАЧЕМ НУЖНО: Снижает джиттер и улучшает регистрацию попаданий.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkInput" IsChecked="True" Content="🟢 3. Честный ввод мыши 1:1 и отключение сна USB-портов"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Отключает акселерацию мыши, залипание клавиш (5x Shift) и сон USB.&#x0a;ЗАЧЕМ НУЖНО: Чёткий контроль прицела без случайного сворачивания игры.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkGameBoost" IsChecked="True" Content="🟡 4. Сессионный игровой режим (Приоритет + пауза служб)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Выставляет высокий приоритет игре и ставит на паузу обновления/поиск Windows.&#x0a;ЗАЧЕМ НУЖНО: Убирает фоновые просадки FPS во время замесов.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkFullscreen" IsChecked="True" Content="🟢 5. Фикс полноэкранного режима и высокий приоритет ГП"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Отключает оптимизацию во весь экран и назначает игре мощный ГП в Windows.&#x0a;ЗАЧЕМ НУЖНО: Уменьшает задержку вывода кадра (Input Lag).">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkTimer" IsChecked="True" Content="🟡 6. Ускорение системного таймера Windows (1.0 мс)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Сжимает шаг таймера прерываний Windows с 15.6 мс до 1.0 мс на время игры.&#x0a;ЗАЧЕМ НУЖНО: Делает фреймтайм в OpenGL/Java максимально ровным.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkMmcss" IsChecked="True" Content="🟡 7. Настройка планировщика игр Windows (MMCSS Priority)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Настраивает ветку реестра Multimedia\Tasks\Games на высокий приоритет.&#x0a;ЗАЧЕМ НУЖНО: Заставляет планировщик Windows отдавать максимум ресурсов игре.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkDns" IsChecked="False" Content="🔴 8. Опциональный подбор быстрого DNS (только по тесту)"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Проверяет пинг до Cloudflare/Google/Яндекс и ставит быстрый DNS.&#x0a;ЗАЧЕМ НУЖНО: Ускоряет подключение к серверам (выключено по умолчанию).">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <CheckBox x:Name="ChkCleanLogs" IsChecked="True" Content="🟢 9. Очистка старых логов и дампов крашей STALZONE"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Удаляет старые текстовые логи и дампы, не трогая ваши настройки игры.&#x0a;ЗАЧЕМ НУЖНО: Освобождает место на SSD и ускоряет запуск клиента.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="ChkTrayMode" IsChecked="True" Content="🟢 10. Сворачивать в трей и ждать запуск/выход игры"/>
                            <Border Style="{StaticResource HelpBadge}" ToolTip="ЧТО ДЕЛАЕТ: Сворачивает программу в трей и автоматически возвращает настройки при выходе из игры.&#x0a;ЗАЧЕМ НУЖНО: Не нагружает систему во время катки.">
                                <TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button x:Name="BtnApplyAndLaunch" Grid.Row="2" Height="44" Margin="0,12,0,0"
                    Content="▶ ПРИМЕНИТЬ ВЫБРАННОЕ И ЗАПУСТИТЬ STALZONE"
                    Background="#00D4AA" Foreground="#111214" FontSize="14" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="BtnApplyAndLaunch_Click"/>
        </Grid>
    </Grid>
</Window>
