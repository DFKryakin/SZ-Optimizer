<Window ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="15000" x:Class="SZOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SZ Optimizer v1.5 | STALZONE Edition (by DFKryakin)" Height="790" Width="1220" MinHeight="750" MinWidth="1150"
        Background="#18191C" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Focusable="True" FontFamily="Segoe UI" Closing="Window_Closing">
            <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="⚡ SZ OPTIMIZER" FontSize="18" FontWeight="Bold" Foreground="#00D4AA" Margin="4,6,0,2"/>
                    <TextBlock Text="STALZONE Edition v1.5" FontSize="11" Foreground="#80848E" Margin="4,0,0,4"/>
                    <TextBlock Text="Создатель: DFKryakin" FontSize="11.5" FontWeight="SemiBold" Foreground="#00D4AA" Margin="4,0,0,2"/>
                    <TextBlock Text="Discord: bylmewka" FontSize="11" Foreground="#B5BAC1" Margin="4,0,0,18"/>
                    <Button x:Name="TabWinBtn" ToolTip="🚀 Вкладка «Оптимизация»:&#10;Главные системные настройки для повышения FPS:&#10;приоритет игры, разгрузка браузера и лаунчеров,&#10;честный ввод мыши и авто-режим при запуске STALZONE." Height="36" Background="#2B2D31" Foreground="White" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabWinBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🚀 Оптимизация" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="TabHwBtn" ToolTip="⚙️ Вкладка «EXBO и Железо»:&#10;Настройка видеокарты и процессора под игру,&#10;безопасная очистка кэша лаунчера EXBO и %TEMP%,&#10;а также переключение серверов RU ↔ EU в 1 клик." Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Cursor="Hand" Click="TabHwBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙️ EXBO и Железо" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="TabJvmBtn" ToolTip="☕ Вкладка «JVM Враппер»:&#10;Увеличивает выделенную оперативную память для игры&#10;с базовых 6 ГБ до 8–16 ГБ и оптимизирует Java (GC/JIT),&#10;убирая микрофризы без изменения файлов игры." Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Cursor="Hand" Click="TabJvmBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="☕ JVM Враппер" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="TabSzCfgBtn" ToolTip="Вкладка «Настройки STALZONE»: 5 готовых пресетов графики в options.json (Ультра, Высокие, Средние, Производительность и Макс. производительность) без урезания дальности прорисовки игроков!" Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabSzCfgBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🎮 Настройки STALZONE" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="TabResBtn" ToolTip="🖥️ Вкладка «Разрешение»:&#10;Позволяет выбрать растянутый экран (4:3 / 16:10)&#10;или задать своё кастомное разрешение и частоту Гц,&#10;а затем сразу записать их в настройки STALZONE." Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabResBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🖥️ Разрешение" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="TabCrossBtn" ToolTip="🎯 Вкладка «Прицел»:&#10;Рисует независимый кастомный прицел поверх игры&#10;без вмешательства в файлы STALZONE. Есть 2 профиля&#10;(например, точка и крест) с переключением по кнопке." Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabCrossBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🎯 Прицел (0% потерь)" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="TabSettingsBtn" ToolTip="Настройки оформления (6 тем + прозрачность), автозапуска, трея и резервного копирования профиля" Height="36" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" Cursor="Hand" Click="TabSettingsBtn_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙️ Настройки и Темы" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Border Background="#2B2D31" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="BackupStatusText" Text="🛡️ Статус: Ожидание игры" FontSize="12" Foreground="#00D4AA" FontWeight="SemiBold"/>
                            <TextBlock Text="Безопасный профиль" FontSize="10.5" Foreground="#949BA4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRollback" ToolTip="Мгновенно возвращает все системные настройки Windows, службы и приоритеты в исходное состояние." Height="36" Background="#3A2326" Foreground="#FF6B6B" FontWeight="SemiBold" BorderBrush="#FF6B6B" BorderThickness="1" Cursor="Hand" Click="BtnRollback_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↺ Откатить всё" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="16">
            <Grid x:Name="PanelWindows" Visibility="Visible">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#222428" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="DiagnosticsText" Text="● ДИАГНОСТИКА: Проверка системы..." FontSize="12.5" Foreground="#00D4AA" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock x:Name="DiagText" Text="• ДИАГНОСТИКА: сканирование..." Foreground="#00D4AA" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button ToolTip="Анализирует процессор, ОЗУ и видеокарту и выставляет оптимальные безопасные галочки." Padding="8,2" FontSize="11" Background="#2B2D31" Foreground="#00D4AA" BorderBrush="#00D4AA" BorderThickness="1" Cursor="Hand" Click="BtnAutoTune_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="🤖 Автоподбор под железо" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#9916181C" BorderBrush="#313338" BorderThickness="1" CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind1" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkAffinity" IsChecked="True" Content="1. Изоляция игры от нулевого ядра CPU 0 (Ровный FPS)"/><Border Style="{StaticResource HelpBadge}" ToolTip="🧠 Что это: запрещает игре нагружать самое первое ядро&#10;процессора (CPU 0), которое занято системными задачами&#10;Windows. 🎮 Кому нужно: полезно на старых 4–8 поточных&#10;процессорах. На современных 12+ поточных лучше&#10;оставить выключенным."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind2" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkGameBoost" IsChecked="True" Content="2. Приоритет игры «Выше среднего» + пауза служб поиска/телеметрии"/><Border Style="{StaticResource HelpBadge}" ToolTip="⚡ Что это: повышает приоритет игры для процессора и&#10;ставит на паузу тяжелые фоновые службы Windows&#10;(индексацию поиска и сбор телеметрии). 🎮 Зачем в&#10;игре: процессор отдаёт больше ресурсов игре, при этом&#10;система и Discord работают стабильно."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind3" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkSoftBrowsers" IsChecked="True" Content="3. Мягкая разгрузка фоновых вкладок браузеров (2-й монитор работает)"/><Border Style="{StaticResource HelpBadge}" ToolTip="🌐 Что это: снижает приоритет открытых вкладок&#10;браузера (Chrome, Edge, Opera, Яндекс, Firefox) во&#10;время игры. 🎮 Зачем в игре: YouTube или музыка на&#10;втором мониторе продолжают работать, но перестают&#10;вызывать просадки FPS."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind4" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkCleanLogs" IsChecked="True" Content="4. Очистка старых текстовых логов и дампов крашей STALZONE"/><Border Style="{StaticResource HelpBadge}" ToolTip="Удаляет старые логи в папке игры, не трогая кэш&#10;шейдеров NVIDIA и настройки."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind5" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkTrayMode" IsChecked="True" Content="5. Фоновый режим: авто-перехват запуска и выхода из игры"/><Border Style="{StaticResource HelpBadge}" ToolTip="Сворачивает оптимизатор и автоматически включает буст&#10;+ прицел при входе в STALZONE."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind6" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkTimer" IsChecked="False" Content="6. Сжатие системного таймера Windows до 1.0 мс (опционально)"/><Border Style="{StaticResource HelpBadge}" ToolTip="⏱️ Что это: уменьшает задержку системного таймера&#10;Windows до 1.0 мс (вместо стандартных 15.6 мс). 🎮&#10;Зачем в игре: делает время кадра (frametime) более&#10;плавным и уменьшает микрозадержки."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind7" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkNetwork" IsChecked="False" Content="7. Оптимизация TCP/IP (Nagle Off — не включать, если уже настроено)"/><Border Style="{StaticResource HelpBadge}" ToolTip="Включает TCPNoDelay=1 в реестре. Если сеть настроена&#10;вручную — оставьте выключенным."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><Ellipse x:Name="Ind8" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkInput" IsChecked="False" Content="8. Честный ввод мыши 1:1 и отключение залипания Shift"/><Border Style="{StaticResource HelpBadge}" ToolTip="🖱️ Что это: отключает программное ускорение мыши&#10;Windows (прицел двигается ровно 1:1 за рукой) и&#10;блокирует случайное окно «Залипание клавиш» при частом&#10;нажатии Shift в бою."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse x:Name="Ind9" Width="9" Height="9" Fill="#6D6F78" Margin="0,0,8,0"/><CheckBox x:Name="ChkSleepLaunchers" IsChecked="True" Content="9. Усыпление фоновых лаунчеров во время игры (Steam, Epic, Overwolf)"/><Border Style="{StaticResource HelpBadge}" ToolTip="🌐 Что это: снижает приоритет открытых вкладок&#10;браузера (Chrome, Edge, Opera, Яндекс, Firefox) во&#10;время игры. 🎮 Зачем в игре: YouTube или музыка на&#10;втором мониторе продолжают работать, но перестают&#10;вызывать просадки FPS."><TextBlock Text="?" Foreground="#00D4AA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                        
            </StackPanel>
        </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnAutoWatch" Grid.Column="0" Height="44" Margin="0,0,8,0" ToolTip="Переводит оптимизатор в режим ожидания: при запуске игры сам применит твики и прицел, а при выходе вернёт систему назад." Background="#00D4AA" Foreground="#111214" FontSize="13.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAutoWatch_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="👁️ АВТО-ОЖИДАНИЕ STALZONE" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                    <Button x:Name="BtnApplyNow" Grid.Column="1" Height="44" ToolTip="Применяет выбранные оптимизации прямо сейчас без ожидания запуска игры." Background="#313338" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnApplyNow_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▶ ПРИМЕНИТЬ СЕЙЧАС" VerticalAlignment="Center"/><Border Style="{StaticResource HelpBadge}"><TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
                </Grid>
            </Grid>
                        <ScrollViewer x:Name="PanelResolution" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="РАЗРЕШЕНИЕ ЭКРАНА И ИГРЫ (4:3 / 16:10 / КАСТОМНОЕ)" FontSize="15" FontWeight="Bold" Foreground="#00D4AA" Margin="0,0,0,10"/>
                    <Border Background="#18191C" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#313338" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="CurrentResText" Text="🖥️ Текущее разрешение: определение..." Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="NativeResText" Text="Родное разрешение монитора: определение..." Foreground="#80848E" FontSize="11.5"/>
                                <TextBlock x:Name="MaxMonitorResText" Text="Максимальный предел монитора: определение..." Foreground="#00D4AA" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#222428" CornerRadius="5" Padding="10,7" BorderBrush="#383A40" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️ Меняет разрешение экрана (чтобы убрать чёрные полосы) и записывает его в STALZONE.&#10;🎮 С галочкой «Авто» применяется ТОЛЬКО во время игры и само возвращается при выходе!" Foreground="#B5BAC1" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="1. БЫСТРЫЕ ПРЕСЕТЫ ПОД МОНИТОР И ВАШИ КАСТОМНЫЕ (ПКМ по своему пресету — удалить):" FontSize="12.5" FontWeight="SemiBold" Foreground="#B5BAC1" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource HelpBadge}" Cursor="Hand" MouseLeftButtonUp="BtnScalingHelp_Click" ToolTip="Нажмите или наведите: как убрать полоску снизу и чёрные полосы на Intel, NVIDIA и AMD при 16:10 / 4:3">
                            <TextBlock Text="?" Foreground="#00D4AA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Border Background="#18191C" CornerRadius="6" Padding="6,6,4,2" Margin="0,0,0,12" BorderBrush="#313338" BorderThickness="1">
                        <ScrollViewer Height="122" VerticalScrollBarVisibility="Visible" Padding="0,0,4,0">
                            <UniformGrid x:Name="PresetsUniformGrid" Columns="3"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="2. СОЗДАТЬ СВОЁ КАСТОМНОЕ РАЗРЕШЕНИЕ:" FontSize="12.5" FontWeight="SemiBold" Foreground="#B5BAC1" Margin="0,0,0,6"/>
                    <Border Background="#18191C" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#313338" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Ширина:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCustomW" LostFocus="TxtRes_LostFocus" Text="1440" Width="70" Height="28" Background="#222428" Foreground="White" BorderBrush="#383A40" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Высота:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCustomH" LostFocus="TxtRes_LostFocus" Text="1080" Width="70" Height="28" Background="#222428" Foreground="White" BorderBrush="#383A40" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Герцовка (Гц):" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCustomHz" LostFocus="TxtRes_LostFocus" Text="144" Width="60" Height="28" Background="#222428" Foreground="#00D4AA" BorderBrush="#383A40" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✨ Применить кастомное" Padding="14,0" Height="32" Background="#00D4AA" Foreground="#111214" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnApplyCustomRes_Click"/>
                                <Button Content="⚡ Макс. монитора" Padding="12,0" Height="32" Background="#2B2D31" Foreground="#4DABF7" BorderBrush="#383A40" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="BtnSetMaxMonitorRes_Click"/><Button Content="➕ В пресеты" Padding="12,0" Height="32" Margin="0,0,8,0" Background="#2B2D31" Foreground="#FFD700" BorderBrush="#383A40" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="BtnSaveCustomRes_Click"/><Button Content="🛠️ CRU" ToolTip="Открыть встроенный CRU без окна UAC (после добавления нажмите 🔄)" Padding="12,0" Height="32" Margin="0,0,8,0" Background="#1D2B3A" Foreground="#4DABF7" BorderBrush="#4DABF7" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="BtnOpenCru_Click"/><Button Content="🔄" ToolTip="Перезапустить драйвер (restart64) и обновить список разрешений" Padding="10,0" Height="32" Background="#2B2D31" Foreground="#00D4AA" BorderBrush="#383A40" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="BtnRefreshResList_Click"/></StackPanel>
                            <TextBlock x:Name="SavedCustomResText" Text="Сохранённое кастомное разрешение: не задано" Foreground="#80848E" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
