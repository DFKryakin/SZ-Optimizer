<Application x:Class="SZOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HelpBadge" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="BorderBrush" Value="#00D4AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="50"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#18191C"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderBrush" Value="#00D4AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Resources>
</Application>
